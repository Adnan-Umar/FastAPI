# ────────────────────────────────────────────────────────────
# A026 — Example environment file
# ────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in real values:
#   cp .env.example .env
#
# `.env` is git-ignored. NEVER commit it with real secrets.
# ────────────────────────────────────────────────────────────

# Comma-separated or JSON list. Both forms are accepted.
# (The .env.example uses JSON for clarity; comma-separated is shorter.)
ORIGINS=["http://localhost", "http://localhost:8000"]

# Used for JWT signing in modules A022 / A023.  CHANGE THIS in real apps.
SECRET_KEY=change-me-to-a-long-random-string

# SQLAlchemy connection string. SQLite is used here for zero-setup demos.
DB_URL=sqlite:///./test.db

# Optional: app name / debug toggle
APP_NAME=A026 Demo API
DEBUG=true
