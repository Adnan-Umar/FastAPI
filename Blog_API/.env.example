# ────────────────────────────────────────────────────────────
# Blog_API — example environment file
# ────────────────────────────────────────────────────────────
# Copy to .env and fill in real values:
#   cp .env.example .env
#
# .env is git-ignored. NEVER commit real secrets.
# ────────────────────────────────────────────────────────────

# SQLAlchemy connection string.
# For local dev (no Postgres needed):
#   DB_URL="sqlite:///./blog.db"
# For production (PostgreSQL on Render/Heroku/etc.):
#   DB_URL="postgresql://USER:PASS@HOST:5432/DB"
DB_URL="postgresql://postgres:password@localhost:5432/blog_db"

# JWT signing secret (HS256). Use a long random string in production.
SECRET_KEY="change-me-to-a-long-random-secret"
